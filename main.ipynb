   "source": [
    "import numpy as np\n",
    "\n",
    "try:\n",
    "    import cupy as cp\n",
    "\n",
    "    if cp.cuda.runtime.getDeviceCount() > 0:\n",
    "        xp = cp\n",
    "        device = \"cuda\"\n",
    "    else:\n",
    "        raise Exception(\"CUDA is not available\")\n",
    "except (ImportError, Exception):\n",
    "    xp = np\n",
    "    device = \"cpu\"\n",
    "\n",
    "device"
   ]
  }
 ],
